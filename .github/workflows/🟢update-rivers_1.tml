name: 🟢update-rivers1

on:
  workflow_dispatch:
    inputs:
      action:
        description: 'Select Action (क्या करना है?)'
        type: choice
        default: 'Hosting Update'
        options:
          - 'Hosting Update'              # Diploment ➡️ Backend
          - 'Diploment Reverse'           # Backend ➡️ Diploment
          - 'Restore from Recycle'        # ♻️ recycle/vX ➡️ Video_Generator
      version:
        description: 'Version (जैसे v3) — खाली छोड़ने पर LATEST अपने आप restore होगा'
        type: string
        required: false
        default: ''

permissions:
  contents: write

jobs:
  sync_process:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    env:
      TOKEN_GITHUB: ${{ secrets.TOKEN_GITHUB }}
      TELEGRAM_API_REPORT_TOKEN: ${{ secrets.TELEGRAM_API_REPORT_TOKEN }}
      TELEGRAM_API_REPORT_CHAT_ID: ${{ secrets.TELEGRAM_API_REPORT_CHAT_ID }}

    steps:
      # ─────────────────────────────────────────────────────────────
      # STEP 1: CHECKOUT (दोनों रेपोज को लोड करना)
      # ─────────────────────────────────────────────────────────────
      - name: 1. 📥 Checkout Diploment (Testing)
        uses: actions/checkout@v4
        with:
          repository: 'sawajstudio-system/Diploment'
          token: ${{ secrets.TOKEN_GITHUB }}
          path: 'Diploment'

      - name: 2. 📥 Checkout Backend (Production)
        uses: actions/checkout@v4
        with:
          repository: 'sawajstudio-system/Backend'
          token: ${{ secrets.TOKEN_GITHUB }}
          path: 'Backend'

      # ─────────────────────────────────────────────────────────────
      # STEP 3A: HOSTING UPDATE (Diploment ➡️ Backend) + RECYCLE
      # ─────────────────────────────────────────────────────────────
      - name: 3A. 🚀 Update Backend (Diploment ➡️ Backend) + Recycle
        if: ${{ inputs.action == 'Hosting Update' }}
        run: |
          echo "🚀 Starting Backend update with recycle backup..."
          
          mkdir -p Backend/recycle
          
          # 1. अगला version नंबर निकालो
          LAST_NUM=$(ls -d Backend/recycle/v* 2>/dev/null \
                     | sed 's#.*/v##' \
                     | grep -E '^[0-9]+$' \
                     | sort -n | tail -1)
          NEXT_NUM=$(( ${LAST_NUM:-0} + 1 ))
          VERSION="v${NEXT_NUM}"
          TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
          BACKUP_DIR="Backend/recycle/$VERSION"
          
          echo "📦 Backup version: $VERSION (at $TIMESTAMP)"
          
          # 2. पुराना Video_Generator → recycle/vX/Video_Generator
          FILES_COUNT=0
          if [ -d "Backend/Video_Generator" ] && [ "$(ls -A Backend/Video_Generator 2>/dev/null)" ]; then
            echo "♻️ Backing up old Video_Generator → recycle/$VERSION/Video_Generator"
            mkdir -p "$BACKUP_DIR"
            mv Backend/Video_Generator "$BACKUP_DIR/Video_Generator"
            FILES_COUNT=$(find "$BACKUP_DIR/Video_Generator" -type f | wc -l)
          else
            echo "ℹ️ No existing Video_Generator to backup (first run)."
          fi
          
          # 3. 📝 info.txt बनाओ
          mkdir -p "$BACKUP_DIR"
          cat > "$BACKUP_DIR/info.txt" <<EOF
          ═══════════════════════════════════════════════
          📦 RECYCLE BACKUP REPORT
          ═══════════════════════════════════════════════
          Version      : $VERSION
          Date         : $TIMESTAMP
          Action       : Hosting Update
          Source       : Diploment (Testing)
          Destination  : Backend (Production)
          Backup Path  : recycle/$VERSION/Video_Generator/
          Files Backed : $FILES_COUNT
          Triggered By : Sawaj Studio Bot
          Workflow Run : $GITHUB_RUN_ID
          Repo         : $GITHUB_REPOSITORY
          Actor        : $GITHUB_ACTOR
          ═══════════════════════════════════════════════
          EOF
          
          echo "📝 Report saved: $BACKUP_DIR/info.txt"
          
          # 4. नया code → Video_Generator
          echo "🚀 Copying fresh code from Diploment..."
          mkdir -p Backend/Video_Generator
          rsync -av \
            --exclude='.git' \
            --exclude='__pycache__' \
            --exclude='*.pyc' \
            --exclude='temp/' \
            Diploment/Video_Generator/ Backend/Video_Generator/
          
          # 5. Commit + Push
          cd Backend
          git config user.name "Sawaj Studio Bot"
          git config user.email "bot@sawajstudio.com"
          git add Video_Generator/ recycle/
          
          if git diff-index --quiet HEAD && [ -z "$(git ls-files --others --exclude-standard)" ]; then
            echo "STATUS=No Changes (Already in sync)" >> $GITHUB_ENV
            echo "BACKUP_VERSION=$VERSION" >> $GITHUB_ENV
          else
            git commit -m "🚀 Update: old code archived as recycle/${VERSION} (${FILES_COUNT} files)"
            git push origin main
            echo "STATUS=Success! Old code → recycle/${VERSION}/Video_Generator (${FILES_COUNT} files)" >> $GITHUB_ENV
            echo "BACKUP_VERSION=$VERSION" >> $GITHUB_ENV
          fi

      # ─────────────────────────────────────────────────────────────
      # STEP 3B: DIPLOMENT REVERSE (Backend ➡️ Diploment)
      # ─────────────────────────────────────────────────────────────
      - name: 3B. 🛡️ Reverse Diploment (Backend ➡️ Diploment)
        if: ${{ inputs.action == 'Diploment Reverse' }}
        run: |
          echo "🚨 Deleting all files inside Diploment/Video_Generator/..."
          rm -rf Diploment/Video_Generator/*
          
          echo "🚀 Copying fresh code from Backend..."
          rsync -av \
            --exclude='.git' \
            --exclude='__pycache__' \
            --exclude='*.pyc' \
            --exclude='temp/' \
            Backend/Video_Generator/ Diploment/Video_Generator/
          
          cd Diploment
          git config user.name "Sawaj Studio Bot"
          git config user.email "bot@sawajstudio.com"
          
          git add Video_Generator/
          
          if git diff-index --quiet HEAD; then
            echo "STATUS=No Changes (Diploment already identical to Backend)" >> $GITHUB_ENV
          else
            git commit -m "🛡️ Diploment Restored: Wiped & Replaced with Backend code"
            git push origin main
            echo "STATUS=Success! Diploment Restored from Backend." >> $GITHUB_ENV
          fi

      # ─────────────────────────────────────────────────────────────
      # STEP 3C: RESTORE FROM RECYCLE (auto-detect latest if empty)
      # ─────────────────────────────────────────────────────────────
      - name: 3C. ♻️ Restore from Recycle (Auto-Detect)
        if: ${{ inputs.action == 'Restore from Recycle' }}
        run: |
          INPUT_VERSION="${{ inputs.version }}"
          
          # 1. Available versions की list निकालो
          AVAILABLE=$(ls -d Backend/recycle/v* 2>/dev/null \
                      | sed 's#.*/v##' \
                      | grep -E '^[0-9]+$' \
                      | sort -n)
          
          if [ -z "$AVAILABLE" ]; then
            echo "❌ recycle/ में कोई version नहीं मिला!"
            echo "STATUS=❌ Failed: No versions in recycle/" >> $GITHUB_ENV
            echo "AVAILABLE_VERSIONS=(none)" >> $GITHUB_ENV
            exit 1
          fi
          
          # 2. Version तय करो (manual या auto)
          if [ -n "$INPUT_VERSION" ]; then
            # Manual version — "4" या "v4" दोनों चलेंगे
            if [[ "$INPUT_VERSION" =~ ^v[0-9]+$ ]]; then
              VERSION="$INPUT_VERSION"
            elif [[ "$INPUT_VERSION" =~ ^[0-9]+$ ]]; then
              VERSION="v${INPUT_VERSION}"
            else
              echo "❌ Invalid version format: $INPUT_VERSION (जैसे v4 लिखें)"
              echo "STATUS=❌ Failed: Invalid version format" >> $GITHUB_ENV
              echo "AVAILABLE_VERSIONS=$(echo "$AVAILABLE" | sed 's/^/v/' | paste -sd ', ')" >> $GITHUB_ENV
              exit 1
            fi
            RESTORE_MODE="Manual"
            echo "🎯 Manual mode: using ${VERSION}"
          else
            # Auto mode — latest version चुनो
            LAST_NUM=$(echo "$AVAILABLE" | tail -1)
            VERSION="v${LAST_NUM}"
            RESTORE_MODE="Auto (latest)"
            echo "🤖 Auto mode: selected latest version ${VERSION}"
          fi
          
          # 3. Check — version में Video_Generator है?
          RESTORE_FROM="Backend/recycle/${VERSION}/Video_Generator"
          
          if [ ! -d "$RESTORE_FROM" ]; then
            echo "❌ ${VERSION} में Video_Generator नहीं मिला!"
            echo "📂 Available versions:"
            echo "$AVAILABLE" | sed 's/^/  v/'
            echo "STATUS=❌ Failed: ${VERSION} has no Video_Generator" >> $GITHUB_ENV
            echo "AVAILABLE_VERSIONS=$(echo "$AVAILABLE" | sed 's/^/v/' | paste -sd ', ')" >> $GITHUB_ENV
            exit 1
          fi
          
          # 4. 📋 Summary प्रिंट करो (log में दिखेगा)
          echo ""
          echo "╔══════════════════════════════════════════════╗"
          echo "║  ♻️  RESTORE FROM RECYCLE — SUMMARY         ║"
          echo "╚══════════════════════════════════════════════╝"
          echo "📂 Available versions in recycle/:"
          echo "$AVAILABLE" | sed 's/^/     ✅ v/'
          echo ""
          echo "🎯 Selected version  : ${VERSION}"
          echo "🤖 Mode             : ${RESTORE_MODE}"
          echo "📁 Restore from     : ${RESTORE_FROM}"
          echo "📁 Restore to       : Backend/Video_Generator"
          echo "══════════════════════════════════════════════"
          
          # 5. Env variables — Telegram में इस्तेमाल होंगे
          echo "RESTORED_VERSION=${VERSION}" >> $GITHUB_ENV
          echo "RESTORE_MODE=${RESTORE_MODE}" >> $GITHUB_ENV
          echo "AVAILABLE_VERSIONS=$(echo "$AVAILABLE" | sed 's/^/v/' | paste -sd ', ')" >> $GITHUB_ENV
          
          # 6. मौजूदा (गलत) code → broken_TIMESTAMP
          TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
          BROKEN_DIR="Backend/recycle/broken_${TIMESTAMP}"
          if [ -d "Backend/Video_Generator" ] && [ "$(ls -A Backend/Video_Generator)" ]; then
            echo "🗑️ Saving current (broken) code → recycle/broken_${TIMESTAMP}"
            mkdir -p "$BROKEN_DIR"
            mv Backend/Video_Generator "$BROKEN_DIR/Video_Generator"
          fi
          echo "BROKEN_BACKUP=broken_${TIMESTAMP}" >> $GITHUB_ENV
          
          # 7. recycle/vX से code वापस लाओ
          mkdir -p Backend/Video_Generator
          rsync -av "$RESTORE_FROM/" Backend/Video_Generator/
          
          # 8. Commit + Push
          cd Backend
          git config user.name "Sawaj Studio Bot"
          git config user.email "bot@sawajstudio.com"
          git add Video_Generator/ recycle/
          
          if git diff-index --quiet HEAD && [ -z "$(git ls-files --others --exclude-standard)" ]; then
            echo "STATUS=No Changes (already same)" >> $GITHUB_ENV
          else
            git commit -m "♻️ Restore: ${VERSION} → Video_Generator (${RESTORE_MODE})"
            git push origin main
            echo "STATUS=✅ Success! Restored ${VERSION} → Video_Generator" >> $GITHUB_ENV
          fi

      # ─────────────────────────────────────────────────────────────
      # STEP 4: TELEGRAM REPORT
      # ─────────────────────────────────────────────────────────────
      - name: 4. 📤 Send Telegram Report
        if: always()
        run: |
          ACTION="${{ inputs.action }}"
          STATUS="${STATUS:-Failed or Cancelled}"
          
          if [ "$ACTION" = "Hosting Update" ]; then
            MSG="🚀 <b>Hosting Update Completed</b>
            
            📥 <b>From:</b> Diploment (Testing)
            📤 <b>To:</b> Backend (Production)
            📁 <b>Folder:</b> Video_Generator
            ♻️ <b>Backup saved as:</b> recycle/${BACKUP_VERSION:-?}
            📊 <b>Status:</b> ${STATUS}"
          
          elif [ "$ACTION" = "Diploment Reverse" ]; then
            MSG="🛡️ <b>Diploment Reverse Completed</b>
            
            🗑️ <b>Action:</b> Diploment code wiped
            📥 <b>Action:</b> Backend code copied
            📁 <b>Folder:</b> Video_Generator
            📊 <b>Status:</b> ${STATUS}"
          
          elif [ "$ACTION" = "Restore from Recycle" ]; then
            MSG="♻️ <b>Restore from Recycle</b>
            
            🤖 <b>Mode:</b> ${RESTORE_MODE:-Manual}
            🎯 <b>Restored Version:</b> ${RESTORED_VERSION:-?}
            📥 <b>From:</b> recycle/${RESTORED_VERSION:-?}
            📤 <b>To:</b> Video_Generator
            🗑️ <b>Broken code saved:</b> recycle/${BROKEN_BACKUP:-?}
            
            📂 <b>All versions in recycle:</b>
            <code>${AVAILABLE_VERSIONS:-none}</code>
            
            📊 <b>Status:</b> ${STATUS}"
          
          else
            MSG="ℹ️ <b>Unknown Action</b>
            📊 <b>Status:</b> ${STATUS}"
          fi
          
          curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_API_REPORT_TOKEN}/sendMessage" \
            -d "chat_id=${TELEGRAM_API_REPORT_CHAT_ID}" \
            --data-urlencode "text=${MSG}" \
            -d "parse_mode=HTML" || true
